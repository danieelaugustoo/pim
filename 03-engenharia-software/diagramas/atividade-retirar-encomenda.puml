@startuml atividade-retirar-encomenda
title Atividade - Retirar encomenda (UC03 / A3)

start
if (Ha encomenda pendente na portaria?) then (sim)
  :tentativas = 0;
  repeat
    :Porteiro informa o codigo mostrado pelo morador;
    :Sistema procura a encomenda PENDENTE com esse codigo;
    :tentativas = tentativas + 1;
    backward :Informa que nenhuma encomenda pendente tem o codigo;
  repeat while (Nao achou e tentativas < 3?) is (sim) not (nao)
  if (Achou uma encomenda?) then (sim)
    :Sistema mostra unidade, destinatario e posicao (sem o codigo);
    if (Porteiro confirma com o morador?) then (sim)
      :Porteiro informa o nome de quem retira;
      :Marca a encomenda como RETIRADA, com data e hora;
      :Libera a posicao na estante;
      :Acrescenta operacao RETIRADA na fila;
    else (nao)
      :Cancela a retirada;
      :Encomenda continua PENDENTE;
    endif
  else (nao)
    :Nega a retirada;
    :Nada e alterado;
  endif
else (nao)
  :Informa que nao ha pendencias;
endif
stop
@enduml
